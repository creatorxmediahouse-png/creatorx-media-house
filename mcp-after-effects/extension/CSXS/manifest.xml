<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.creatorx.aemcp" ExtensionBundleVersion="0.2.0" ExtensionBundleName="After Effects MCP">
  <ExtensionList>
    <Extension Id="com.creatorx.aemcp.panel" Version="0.2.0" />
    <Extension Id="com.creatorx.aemcp.bridge" Version="0.2.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <!-- After Effects 2019 (16.0) and newer -->
      <Host Name="AEFT" Version="[16.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <!-- The visible panel. It opens only from Window > Extensions, so closing it keeps it closed. -->
    <Extension Id="com.creatorx.aemcp.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>After Effects MCP</Menu>
          <Geometry>
            <Size><Height>600</Height><Width>360</Width></Size>
            <MinSize><Height>320</Height><Width>260</Width></MinSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <!-- A hidden helper that runs the bridge for AI apps from the moment After Effects starts. -->
    <Extension Id="com.creatorx.aemcp.bridge">
      <DispatchInfo>
        <Resources>
          <MainPath>./bridge.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size><Height>1</Height><Width>1</Width></Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
